{
  "name": "@nanostores/router",
  "version": "1.1.0",
  "description": "A tiny (765 bytes) router for Nano Stores state manager",
  "keywords": [
    "nano",
    "preact",
    "react",
    "router",
    "store",
    "svelte",
    "vue"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "nanostores/router",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:lint": "oxlint",
    "test:coverage": "pnpm bnt --coverage 100",
    "test:types": "check-dts",
    "test:size": "size-limit",
    "test": "pnpm run /^test:/"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.2.0",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "better-node-test": "^1.0.0",
    "check-dts": "^2.0.1",
    "jsdom": "^30.1.1",
    "nanostores": "^1.5.4",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "size-limit": "^14.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "nanostores": "^0.9.0 || ^0.10.0 || ^0.11.0 || ^1.0.0"
  },
  "size-limit": [
    {
      "name": "Router",
      "import": {
        "./index.js": "{ createRouter }"
      },
      "limit": "765 B"
    }
  ],
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "clean-publish": {
    "cleanDocs": true
  }
}
